# Template for the root `.env` (copy: `Copy-Item docs\env.template .env`, then fill in).
# `.env` is gitignored and holds real secrets: never commit it, never paste it in chats or logs.
# Every variable below is read by the code (checked 2026-10-26). Values here are examples.

# --- Runtime ---------------------------------------------------------------
APP_ENV=development                     # `test` is set by tests/conftest.py (it also lets the Host guard accept `testserver`)
ALLOW_DEMO_FALLBACK=true                # market-data routes serve synthetic data when the DB is down; the ledger never does
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:47319,http://127.0.0.1:47319
API_ALLOWED_HOSTS=localhost,127.0.0.1   # DNS-rebinding guard; `*` disables it
API_TRUST_PROXY=false                   # true only behind a reverse proxy (then X-Forwarded-For is trusted)
API_RATE_LIMIT_PER_MINUTE=240

# --- Database (PostgreSQL 18, local) ----------------------------------------
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ia_inversiones
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ia_inversiones_test   # pytest applies migrations here, never to LOCAL_DATABASE_URL
# Alternative to LOCAL_DATABASE_URL (used only when it is empty): PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD

# --- Frontend (baked in at Vite build/start time, not runtime) ----------------
# The always-on app serves the API on 47318 and the UI on 47319 (ops/run_local_app.ps1).
VITE_API_BASE_URL=http://localhost:47318/api

# --- Telegram expense bot (ops/finance_bot.py) and alerts ----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FINANCE_DEFAULT_CURRENCY=MXN
FINANCE_DEFAULT_ACCOUNT_NAME=           # optional: account the bot books into by default
OPERATIONAL_WEBHOOK_URL=                # optional generic webhook for job notifications

# --- Third-party data (all optional: without them the feature reports "no configurado") ----
SEC_USER_AGENT=                         # required by SEC EDGAR: "Your Name your@email"
BANXICO_TOKEN=                          # Banxico SIE: Mexican macro series and, later, INPC for cost updates
FINNHUB_API_KEY=                        # news sentiment

# --- Backups (ops/backup_db.ps1, scheduled task Faro\DailyBackup) -----------------
FARO_BACKUP_DIR=C:\Respaldos\Faro
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe   # only if pg_dump is not on PATH

# --- Optional ----------------------------------------------------------------
# MODEL_ARTIFACT_DIR=models             # where trained .joblib files live (default `models`, relative to the repo root)
