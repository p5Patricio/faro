APP_ENV=development
ALLOW_DEMO_FALLBACK=true
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Local PostgreSQL ---
LOCAL_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ia_inversiones
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ia_inversiones_test

VITE_API_BASE_URL=http://localhost:8000/api

# --- Telegram notifications (optional) ---
